    "iz_faq_XEeggT": {
      "type": "iz-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Comment savoir quel soin me convient ?",
            "reponse": "<p>Le diagnostic en ligne pose huit questions sur ce que vous observez et sur vos habitudes, puis indique le soin qui répond à votre besoin principal. Il prend moins d'une minute et peut conclure qu'un seul soin suffit.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Le masque et le sérum s'utilisent-ils ensemble ?",
            "reponse": "<p>Oui, et ils n'ont pas le même rythme. Le masque se pose une à deux fois par semaine, puis se rince. Le sérum s'applique matin et soir sur peau propre. Les jours de masque, le sérum vient après le rinçage.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Les formules conviennent-elles à toutes les peaux ?",
            "reponse": "<p>Les formules sont sans parfum ajouté et à un pH proche de celui de la peau. Elles conviennent à toutes les carnations. Si votre peau est réactive, espacez les poses de masque et commencez le sérum un soir sur deux.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "À partir de quel montant la livraison est-elle offerte ?",
            "reponse": "<p>Dès 39 € d'achat en France. En dessous, les frais sont calculés au moment du paiement selon l'adresse de livraison.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Puis-je payer en plusieurs fois ?",
            "reponse": "<p>Oui, en quatre fois sans frais avec PayPal, au moment du paiement.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Puis-je retourner un produit ?",
            "reponse": "<p>Oui, sous quatorze jours, à condition que le produit n'ait pas été ouvert. Écrivez-nous et nous vous indiquons la marche à suivre.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "Vos produits sont-ils testés sur les animaux ?",
            "reponse": "<p>Non. Aucune de nos formules n'est testée sur les animaux, et nous ne travaillons avec aucun fournisseur qui le ferait.</p>"
          }
        }
      },
