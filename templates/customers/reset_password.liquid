{% comment %}
  Choix d'un nouveau mot de passe, depuis le lien reçu par e-mail.
{% endcomment %}

{% render 'compte' %}

<div class="compte">
  <p class="compte__sur">Votre compte</p>
  <h1 class="compte__titre">Nouveau mot de passe</h1>
  <p class="compte__texte">Choisissez un mot de passe pour votre compte Irizée.</p>

  {% form 'reset_customer_password', novalidate: 'novalidate' %}
    {%- if form.errors -%}
      <div class="compte__erreurs" role="alert">
        <ul>
          {%- for champ in form.errors -%}
            <li>{{ form.errors.messages[champ] }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="compte__form">
      <div class="compte__champ">
        <label class="compte__label" for="nouveau-mdp">Mot de passe</label>
        <input type="password" id="nouveau-mdp" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="compte__champ">
        <label class="compte__label" for="nouveau-mdp-2">Confirmation</label>
        <input type="password" id="nouveau-mdp-2" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <div class="compte__actions">
        <button type="submit" class="iz-btn iz-btn--primary">Enregistrer</button>
      </div>
    </div>
  {% endform %}
</div>
