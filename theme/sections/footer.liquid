<footer>
  <div class="footer__copyright">
    &copy;
    {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url }}
  </div>
</footer>

{% stylesheet %}
  footer {
    padding: 2rem var(--page-margin);
    text-align: center;
    font-size: 1.2rem;
  }
  footer a {
    text-decoration: none;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": []
}
{% endschema %}
