{% comment %}
  Shopify ne charge qu'un seul groupe de sections pour l'en-tête : il n'existe
  pas de « header de la page produit » à régler à part. On détecte donc le type
  de page et on applique des valeurs alternatives pour ce qui doit différer.

  Sur une fiche produit il n'y a pas de hero : la superposition y est désactivée
  par défaut, ce qui remet aussi le header en position collante plutôt que fixe.
{% endcomment %}
{% assign reglages_pdp = false %}
{% if request.page_type == 'product' and section.settings.pdp_override %}
  {% assign reglages_pdp = true %}
{% endif %}

{% assign is_overlay = section.settings.overlay_on_image %}
{% assign couleur_texte = section.settings.overlay_text_color %}
{% assign couleur_logo = section.settings.logo_color %}

{% if reglages_pdp %}
  {% assign is_overlay = section.settings.pdp_overlay %}
  {% assign couleur_texte = section.settings.pdp_text_color %}
  {% assign couleur_logo = section.settings.pdp_logo_color %}
{% endif %}

{% comment %} Logo affiché en haut de page (sur l'image, si superposé) {% endcomment %}
{% assign top_logo_white = false %}
{% if is_overlay and couleur_logo == 'white' %}
  {% assign top_logo_white = true %}
{% endif %}
{% assign top_logo_image = section.settings.logo %}
{% assign top_logo_fallback = 'irizee-logo.png' %}
{% if top_logo_white %}
  {% assign top_logo_image = section.settings.logo_white %}
  {% assign top_logo_fallback = 'irizee-logo-white.png' %}
{% endif %}

{% comment %} Logo affiché une fois scrollé (fond flouté clair) {% endcomment %}
{% assign scrolled_logo_white = false %}
{% if section.settings.scrolled_logo_color == 'white' %}
  {% assign scrolled_logo_white = true %}
{% endif %}
{% assign scrolled_logo_image = section.settings.logo %}
{% assign scrolled_logo_fallback = 'irizee-logo.png' %}
{% if scrolled_logo_white %}
  {% assign scrolled_logo_image = section.settings.logo_white %}
  {% assign scrolled_logo_fallback = 'irizee-logo-white.png' %}
{% endif %}

{% style %}
  {{ section.settings.menu_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .header {
    --menu-font-family: {{ section.settings.menu_font.family }}, {{ section.settings.menu_font.fallback_families }};
    --menu-font-weight: {{ section.settings.menu_font.weight }};
    --menu-font-style: {{ section.settings.menu_font.style }};
    --menu-font-size: {{ section.settings.menu_font_size }}px;
    --menu-letter-spacing: {{ section.settings.menu_letter_spacing }}px;
    --header-icon-size: {{ section.settings.icon_size }}px;
    --header-icon-gap: {{ section.settings.icon_gap }}px;
    --header-logo-width: {{ section.settings.logo_width }}px;
    --header-blur: {{ section.settings.blur_intensity }}px;
    --menu-item-gap: {{ section.settings.menu_item_gap }}px;
    --header-column-gap: {{ section.settings.header_column_gap }}px;
    --header-padding-desktop: {{ section.settings.header_padding_desktop }}px;
    --header-padding-mobile: {{ section.settings.header_padding_mobile }}px;
    --header-padding-top-desktop: {{ section.settings.header_padding_top_desktop }}px;
    --header-padding-bottom-desktop: {{ section.settings.header_padding_bottom_desktop }}px;
    --header-padding-top-mobile: {{ section.settings.header_padding_top_mobile }}px;
    --header-padding-bottom-mobile: {{ section.settings.header_padding_bottom_mobile }}px;
    --header-scrolled-height: {{ section.settings.scrolled_height }}px;
    --header-scrolled-logo-width: {{ section.settings.scrolled_logo_width }}px;
  }

  {%- if reglages_pdp -%}
    /* Valeurs propres aux pages produit. Déclarées après les valeurs
       générales pour l'emporter, sans les modifier ailleurs. */
    /* Le header reste en position fixe même sans superposition. En `sticky`,
       son conteneur ne fait que sa propre hauteur : il n'a aucun espace où
       coller et disparaîtrait dès le premier défilement. La section produit
       compense cette hauteur pour que rien ne passe dessous. */
    #shopify-section-{{ section.id }} .header--pdp {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      min-height: {{ section.settings.pdp_height }}px;
      padding-top: 0;
      padding-bottom: 0;
      background: var(--color-background);
    }

    #shopify-section-{{ section.id }} .header--pdp .header__logo {
      width: {{ section.settings.pdp_logo_width }}px;
    }

    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .header--pdp {
        min-height: {{ section.settings.pdp_height_mobile }}px;
      }

      #shopify-section-{{ section.id }} .header--pdp .header__logo {
        width: {{ section.settings.pdp_logo_width_mobile }}px;
      }
    }

    /* Hors superposition, la couleur vient du thème : il faut donc la poser
       explicitement pour que le réglage serve dans les deux cas. */
    #shopify-section-{{ section.id }} .header--pdp-white:not(.header--scrolled) {
      color: #fff;
    }

    #shopify-section-{{ section.id }} .header--pdp-black:not(.header--scrolled) {
      color: #1a1a1a;
    }
  {%- endif -%}

  /* Le header doit occuper toute la largeur de l'écran. La classe
     `full-width` ne suffit pas : elle dépend de la règle
     `.shopify-section > .full-width`, qui ne s'applique pas ici parce que
     Shopify enveloppe autrement les sections appartenant à un groupe.
     On neutralise donc la grille de page sur le conteneur de la section
     elle-même, ce qui ne dépend d'aucune hypothèse sur cet enrobage. */
  #shopify-section-{{ section.id }} {
    display: block;
  }

  /* Réglages mobiles : indépendants des valeurs ordinateur ci-dessus */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .header {
      --menu-font-size: {{ section.settings.menu_font_size_mobile }}px;
      --menu-letter-spacing: {{ section.settings.menu_letter_spacing_mobile }}px;
      --menu-item-gap: {{ section.settings.menu_item_gap_mobile }}px;
      --header-icon-size: {{ section.settings.icon_size_mobile }}px;
      --header-icon-gap: {{ section.settings.icon_gap_mobile }}px;
      --header-logo-width: {{ section.settings.logo_width_mobile }}px;
      --header-scrolled-height: {{ section.settings.scrolled_height_mobile }}px;
      --header-scrolled-logo-width: {{ section.settings.scrolled_logo_width_mobile }}px;
    }
  }

{% endstyle %}

<header class="header full-width header--survol-{{ section.settings.menu_hover_style }}{% if reglages_pdp %} header--pdp header--pdp-{{ couleur_texte }}{% endif %}{% if is_overlay %} header--overlay header--overlay-{{ couleur_texte }}{% if section.settings.enable_blur %} header--blur{% endif %}{% endif %}">
  <details class="header__mobile-nav">
    <summary class="header__hamburger" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </summary>
    <nav class="header__mobile-menu header__menu--{{ section.settings.menu_text_transform }}">
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    </nav>
  </details>

  <nav class="header__menu header__menu--left header__menu--{{ section.settings.menu_text_transform }}">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </nav>

  <a href="{{ routes.root_url }}" class="header__logo-link" aria-label="{{ shop.name }}">
    {% if top_logo_image %}
      {{
        top_logo_image
        | image_url: width: 220
        | image_tag: class: 'header__logo header__logo--top', alt: shop.name, width: 110, height: 35, loading: 'eager'
      }}
    {% else %}
      <img
        src="{{ top_logo_fallback | asset_url }}"
        alt="{{ shop.name }}"
        class="header__logo header__logo--top"
        width="110"
        height="35"
        loading="eager"
      >
    {% endif %}

    {% if is_overlay %}
      {% if scrolled_logo_image %}
        {{
          scrolled_logo_image
          | image_url: width: 220
          | image_tag: class: 'header__logo header__logo--scrolled', alt: shop.name, width: 110, height: 35, loading: 'lazy'
        }}
      {% else %}
        <img
          src="{{ scrolled_logo_fallback | asset_url }}"
          alt="{{ shop.name }}"
          class="header__logo header__logo--scrolled"
          width="110"
          height="35"
          loading="lazy"
        >
      {% endif %}
    {% endif %}
  </a>

  <div class="header__icons">
    <a href="{{ routes.search_url }}" aria-label="Rechercher">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
        <circle cx="8.75" cy="8.75" r="5.75" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
        <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m17 17-4.2-4.2" />
      </svg>
    </a>

    {% if shop.customer_accounts_enabled %}
      <shopify-account class="header__account-native" menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
      <a href="{{ routes.account_url }}" class="header__account-mobile" aria-label="Compte">
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% if is_overlay %}
  <script>
    (function () {
      var header = document.querySelector('.header--overlay');
      if (!header) return;
      var threshold = 80;
      var hideOnScrollDown = {{ section.settings.hide_on_scroll | json }};
      var lastScrollY = window.scrollY;
      var ticking = false;

      function updateHeader() {
        var currentScrollY = window.scrollY;

        if (currentScrollY > threshold) {
          header.classList.add('header--scrolled');
        } else {
          header.classList.remove('header--scrolled');
        }

        if (hideOnScrollDown) {
          if (currentScrollY > lastScrollY && currentScrollY > threshold) {
            header.classList.add('header--hidden');
          } else {
            header.classList.remove('header--hidden');
          }
        }

        lastScrollY = currentScrollY;
        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      updateHeader();
    })();
  </script>
{% endif %}

{% stylesheet %}
  /* min-height et non height : sans ça la marge verticale serait absorbée
     par le border-box et le menu ne grandirait pas. */
  .header {
    min-height: 8.2rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--header-column-gap, 16px);
    padding:
      var(--header-padding-top-desktop, 0)
      var(--header-padding-desktop, var(--page-margin))
      var(--header-padding-bottom-desktop, 0);
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-background);
    color: var(--color-foreground);
    transition:
      background-color 0.3s ease,
      backdrop-filter 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease,
      min-height 0.3s ease,
      padding-top 0.3s ease,
      padding-bottom 0.3s ease;
  }

  .header .header__logo {
    transition: width 0.3s ease;
  }

  .header--overlay {
    /* position:sticky ne fonctionne pas ici : la marge négative qui fait
       chevaucher le header sur le hero réduit aussi son propre conteneur à
       ~0px, ce qui lui retire tout espace où "coller". position:fixed
       contourne le problème (le header sort complètement du flux, donc le
       hero démarre naturellement en haut sans qu'on ait besoin de marge
       négative). */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
  }

  .header--overlay-white {
    color: #fff;
  }

  .header--overlay-black {
    color: #1a1a1a;
  }

  /* État "scrollé" : une fois qu'on quitte le hero, le header passe d'un
     fond transparent à un fond flouté/translucide, texte repassé en couleur
     normale du site — transition douce plutôt qu'un changement brusque. */
  .header--overlay.header--scrolled {
    background: color-mix(in srgb, var(--color-background) 75%, transparent);
    color: var(--color-foreground);
  }

  /* Une fois scrollé, le menu devient une barre utilitaire : il ne reprend
     plus les marges généreuses pensées pour la superposition sur le hero,
     mais une hauteur cible propre. Les marges sont remises à zéro pour que
     cette hauteur soit exactement celle demandée — `align-items: center`
     sur la grille recentre le contenu de lui-même. */
  .header--scrolled {
    min-height: var(--header-scrolled-height, 64px);
    padding-top: 0;
    padding-bottom: 0;
  }

  .header--scrolled .header__logo {
    width: var(--header-scrolled-logo-width, 84px);
  }

  .header--overlay.header--scrolled.header--blur {
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
  }

  /* Se cache en scrollant vers le bas, réapparaît dès qu'on remonte. */
  .header--hidden {
    transform: translateY(-100%);
  }

  .header .header__logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header__menu--left {
    justify-self: start;
  }

  .header__icons {
    justify-self: end;
  }

  .header .header__logo {
    width: var(--header-logo-width, 110px);
    height: auto;
    /* Alignement optique : les points du logo (i, z) tirent son centre
       géométrique vers le haut par rapport au corps des lettres — on
       recale sur le centre visuel réel plutôt que sur la boîte englobante. */
    transform: translateY(-0.56rem);
  }

  /* Deux logos superposables (couleur "en haut" / couleur "scrollé") — un
     seul visible à la fois, basculé par la classe .header--scrolled. */
  .header__logo--scrolled {
    display: none;
  }

  .header--scrolled .header__logo--top {
    display: none;
  }

  .header--scrolled .header__logo--scrolled {
    display: block;
  }

  .header a {
    position: relative;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header .header__menu a,
  .header .header__mobile-menu a {
    font-family: var(--menu-font-family);
    font-weight: var(--menu-font-weight);
    font-style: var(--menu-font-style);
  }

  .header .header__menu a {
    font-size: var(--menu-font-size);
    letter-spacing: var(--menu-letter-spacing);
  }

  /* ---------- Retour visuel au survol ----------
     Les effets s'appuient sur currentColor : ils restent lisibles aussi bien
     en superposition claire sur le hero qu'une fois le header scrollé. */

  .header .header__menu a {
    position: relative;
    transition: opacity 0.2s ease;
  }

  /* Le trait est un pseudo-élément et non un border-bottom : il se déploie
     depuis la gauche sans décaler le texte ni modifier la hauteur du menu. */
  .header--survol-trait .header__menu a::after,
  .header--survol-les-deux .header__menu a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.4rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .header__icons a,
  .header__logo-link {
    transition: opacity 0.2s ease;
  }

  /* Réservé aux appareils à souris : sur tactile, :hover reste collé après
     le toucher et laisserait un élément surligné à tort. */
  @media (hover: hover) {
    .header--survol-trait .header__menu a:hover::after,
    .header--survol-les-deux .header__menu a:hover::after {
      transform: scaleX(1);
    }

    .header--survol-opacite .header__menu a:hover,
    .header--survol-les-deux .header__menu a:hover {
      opacity: 0.55;
    }

    .header__icons a:hover,
    .header__logo-link:hover {
      opacity: 0.55;
    }
  }

  /* Au clavier, le trait et l'opacité suivent la même logique que la souris :
     sans cela, la navigation au Tab ne montrerait aucun élément actif. */
  .header .header__menu a:focus-visible::after {
    transform: scaleX(1);
  }

  .header .header__menu a:focus-visible,
  .header__icons a:focus-visible,
  .header__logo-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .header .header__menu a,
    .header .header__menu a::after,
    .header__icons a,
    .header__logo-link {
      transition: none;
    }
  }

  .header__menu--uppercase a {
    text-transform: uppercase;
  }

  .header__menu--lowercase a {
    text-transform: lowercase;
  }

  .header__menu--capitalize a {
    text-transform: capitalize;
  }

  .header__menu--none a {
    text-transform: none;
  }

  .header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }

  .header svg {
    width: var(--header-icon-size, 18px);
    height: var(--header-icon-size, 18px);
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
  }

  .header__menu,
  .header__icons {
    display: flex;
    align-items: center;
    gap: var(--header-icon-gap, 24px);
  }

  .header__menu {
    gap: var(--menu-item-gap, 24px);
  }

  /* Lien compte simplifié, affiché uniquement sous 750px (voir media query) —
     le composant natif Shopify a une taille interne fixe qui ne correspond
     pas aux icônes recherche/panier une fois réduite, donc pas de bricolage
     dessus : sur mobile on affiche notre propre icône à la bonne taille à la
     place, en lien direct vers la page compte. */
  .header .header__account-mobile {
    display: none;
  }

  .header__icons a {
    flex-shrink: 0;
  }

  /* Shopify injecte parfois un élément vide (shopify-store) entre les icônes,
     ce qui casse le gap flex — on le retire du flux. */
  .header__icons shopify-store:empty {
    display: none;
  }

  /* Mobile hamburger — caché par défaut, affiché sous 750px */
  .header__mobile-nav {
    display: none;
    justify-self: start;
  }

  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    width: 2.2rem;
    height: 2.2rem;
    cursor: pointer;
    list-style: none;
  }

  .header__hamburger::-webkit-details-marker {
    display: none;
  }

  .header__hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
  }

  .header__mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding: 2.4rem var(--page-margin) 3.2rem;
    background: var(--color-background);
    color: var(--color-foreground);
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .header__mobile-menu a {
    font-size: 1.6rem;
    justify-content: flex-start;
  }

  @media (max-width: 749px) {
    .header__menu--left {
      display: none;
    }

    .header__mobile-nav {
      display: block;
    }

    .header {
      column-gap: 0.8rem;
      padding:
        var(--header-padding-top-mobile, 0)
        var(--header-padding-mobile, 16px)
        var(--header-padding-bottom-mobile, 0);
    }

    .header .header__account-native {
      display: none;
    }

    .header .header__account-mobile {
      display: flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_white",
      "label": "Logo (version blanche, si superposé sur une image)"
    },
    {
      "type": "checkbox",
      "id": "overlay_on_image",
      "label": "Superposer le header sur la section suivante",
      "default": false
    },
    {
      "type": "select",
      "id": "logo_color",
      "label": "Couleur du logo quand superposé",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "black",
          "label": "Noir"
        }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "scrolled_logo_color",
      "label": "Couleur du logo une fois scrollé",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "black",
          "label": "Noir"
        }
      ],
      "default": "black"
    },
    {
      "type": "select",
      "id": "overlay_text_color",
      "label": "Couleur du menu et des icônes quand superposé",
      "options": [
        {
          "value": "white",
          "label": "Blanc"
        },
        {
          "value": "black",
          "label": "Noir"
        }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "enable_blur",
      "label": "Effet de flou (verre dépoli) une fois scrollé",
      "default": true
    },
    {
      "type": "range",
      "id": "blur_intensity",
      "label": "Intensité du flou",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Cacher le header en scrollant vers le bas",
      "default": true
    },
    {
      "type": "header",
      "content": "Typographie du menu"
    },
    {
      "type": "font_picker",
      "id": "menu_font",
      "label": "Police du menu",
      "default": "work_sans_n7"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Taille du texte — ordinateur",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "menu_font_size_mobile",
      "label": "Taille du texte — mobile",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "menu_letter_spacing",
      "label": "Espacement des lettres — ordinateur",
      "min": -1,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "menu_letter_spacing_mobile",
      "label": "Espacement des lettres — mobile",
      "min": -1,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
