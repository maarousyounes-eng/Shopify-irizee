<div class="announcement-bar">
  <p>{{ section.settings.text }}</p>
</div>

{% stylesheet %}
  .announcement-bar {
    background: var(--announcement-bg, #EFEDE8);
    padding: 1rem var(--page-margin);
    text-align: center;
  }
  .announcement-bar p {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Livraison offerte dès 45€ d'achat"
    }
  ]
}
{% endschema %}
