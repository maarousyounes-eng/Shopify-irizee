{% comment %}
  Fiche produit — galerie.

  Première brique de la section d'achat. Le bloc d'achat viendra s'ajouter
  ici une fois la galerie validée.

  Les médias viennent du produit Shopify : photos et vidéos, dans l'ordre
  défini dans l'admin. Aucun média en dur.
{% endcomment %}

{%- assign p = product -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --izg-ratio: {{ section.settings.ratio }};
    --izg-thumb-gap: {{ section.settings.thumb_gap }}px;
  }
{% endstyle %}

{%- if p.media.size > 0 -%}
  <section class="iz-section iz-gallery-section full-width">
    <div class="iz-container">
      <div class="iz-gallery" data-iz-gallery>

        <div class="iz-gallery__stage" data-iz-stage>
          {%- for media in p.media -%}
            <figure
              class="iz-gallery__slide{% if forloop.first %} is-active{% endif %}"
              data-iz-slide="{{ forloop.index0 }}"
            >
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}
              {%- else -%}
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 750px) 46vw, 92vw"
                  alt="{{ media.alt | escape | default: p.title | escape }}"
                  width="1200"
                  height="1200"
                  {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                >
              {%- endif -%}
            </figure>
          {%- endfor -%}

          {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
            <span class="iz-gallery__badge">{{ section.settings.badge_text }}</span>
          {%- endif -%}

          {%- if p.media.size > 1 -%}
            <div class="iz-gallery__dots" aria-hidden="true">
              {%- for media in p.media -%}
                <span class="iz-gallery__dot{% if forloop.first %} is-active{% endif %}" data-iz-dot="{{ forloop.index0 }}"></span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- if p.media.size > 1 -%}
          <ul class="iz-gallery__thumbs" role="list">
            {%- for media in p.media limit: section.settings.thumb_count -%}
              <li>
                <button
                  type="button"
                  class="iz-gallery__thumb iz-tap{% if forloop.first %} is-active{% endif %}"
                  data-iz-thumb="{{ forloop.index0 }}"
                  aria-label="{{ section.settings.libelle_vignette }} {{ forloop.index }}"
                >
                  <img
                    src="{{ media.preview_image | image_url: width: 240 }}"
                    alt=""
                    width="240"
                    height="240"
                    loading="lazy"
                  >
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      var slides = root.querySelectorAll('[data-iz-slide]');
      var thumbs = root.querySelectorAll('[data-iz-thumb]');
      var dots = root.querySelectorAll('[data-iz-dot]');
      var courant = 0;

      function montrer(i) {
        courant = parseInt(i, 10) || 0;
        slides.forEach(function (s) { s.classList.toggle('is-active', s.dataset.izSlide === String(courant)); });
        thumbs.forEach(function (t) { t.classList.toggle('is-active', t.dataset.izThumb === String(courant)); });
        dots.forEach(function (d) { d.classList.toggle('is-active', d.dataset.izDot === String(courant)); });
      }

      thumbs.forEach(function (t) {
        t.addEventListener('click', function () { montrer(t.dataset.izThumb); });
      });

      /* Balayage au doigt. Les gestionnaires sont passifs et n'appellent
         jamais preventDefault : le défilement vertical de la page doit
         continuer de fonctionner par-dessus la galerie. */
      var stage = root.querySelector('[data-iz-stage]');
      if (stage && slides.length > 1) {
        var x0 = 0, y0 = 0, suit = false;
        stage.addEventListener('touchstart', function (e) {
          x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; suit = true;
        }, { passive: true });
        stage.addEventListener('touchend', function (e) {
          if (!suit) return;
          suit = false;
          var dx = e.changedTouches[0].clientX - x0;
          var dy = e.changedTouches[0].clientY - y0;
          if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
          montrer(dx < 0
            ? Math.min(courant + 1, slides.length - 1)
            : Math.max(courant - 1, 0));
        }, { passive: true });
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .iz-gallery__stage {
    position: relative;
    background: var(--iz-surface);
    border-radius: var(--iz-radius);
    overflow: hidden;
    aspect-ratio: var(--izg-ratio, 1);
  }

  .iz-gallery__slide {
    margin: 0;
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .iz-gallery__slide.is-active {
    opacity: 1;
  }

  .iz-gallery__slide img,
  .iz-gallery__slide video,
  .iz-gallery__slide iframe {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .iz-gallery__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--iz-ink);
    color: var(--iz-bg);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--iz-radius-pill);
  }

  /* Points de pagination : repère de position pendant le balayage, donc
     réservés au mobile où le balayage existe. */
  .iz-gallery__dots {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .iz-gallery__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #B5B5B5;
    transition: width 0.2s ease, background-color 0.2s ease;
  }

  .iz-gallery__dot.is-active {
    width: 18px;
    background: var(--iz-ink);
  }

  .iz-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(var(--izg-thumbs, 5), 1fr);
    list-style: none;
    margin: var(--izg-thumb-gap, 12px) 0 0;
    padding: 0;
    gap: var(--izg-thumb-gap, 12px);
  }

  .iz-gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--iz-radius-inner);
    background: var(--iz-surface);
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 1;
    transition: border-color 0.2s ease;
  }

  .iz-gallery__thumb.is-active {
    border-color: var(--iz-ink);
  }

  .iz-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 750px) {
    /* Sur ordinateur, les vignettes remplacent le balayage : les points
       n'ont plus de rôle. */
    .iz-gallery__dots {
      display: none;
    }
  }

  @media (max-width: 749px) {
    .iz-gallery__thumbs {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iz-gallery__slide,
    .iz-gallery__dot,
    .iz-gallery__thumb {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiche — galerie",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Afficher le badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Texte du badge", "default": "Best" },

    { "type": "header", "content": "Image" },
    { "type": "range", "id": "ratio", "label": "Proportion de l'image", "info": "1 = carré. En dessous, l'image est plus haute que large.", "min": 0.6, "max": 1.6, "step": 0.1, "default": 1 },

    { "type": "header", "content": "Vignettes" },
    { "type": "range", "id": "thumb_count", "label": "Nombre de vignettes", "info": "Masquées sur mobile, où le balayage les remplace.", "min": 3, "max": 8, "step": 1, "default": 5 },
    { "type": "range", "id": "thumb_gap", "label": "Espace entre les vignettes", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 },

    { "type": "header", "content": "Accessibilité" },
    { "type": "text", "id": "libelle_vignette", "label": "Libellé des vignettes", "info": "Lu par les lecteurs d'écran, suivi du numéro.", "default": "Voir le média" }
  ],
  "presets": [{ "name": "Fiche — galerie" }]
}
{% endschema %}
