{% comment %}
  Fiche produit — galerie et bloc d'achat.

  Le bloc d'achat est entièrement composé de blocs réordonnables : chaque
  élément se déplace, se masque ou se retire depuis l'éditeur.

  Le contenu propre à chaque produit vient des metafields `custom` ; tant
  qu'un metafield est vide, l'élément correspondant ne s'affiche pas.
{% endcomment %}

{%- assign p = product -%}
{%- assign variant = p.selected_or_first_available_variant -%}
{%- assign offres = p.metafields.custom.offres.value -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --izp-gallery-ratio: {{ section.settings.gallery_ratio }};
    --izp-col-gap: {{ section.settings.column_gap }}px;
  }
{% endstyle %}

<section class="iz-section iz-product full-width" data-iz-product>
  <div class="iz-container iz-product__grid">

    {%- comment -%} ---------------- Galerie ---------------- {%- endcomment -%}
    <div class="iz-product__gallery">
      <div class="iz-gallery__stage" data-iz-stage>
        {%- if p.media.size > 0 -%}
          {%- for media in p.media -%}
            <figure
              class="iz-gallery__slide{% if forloop.first %} is-active{% endif %}"
              data-iz-slide="{{ forloop.index0 }}"
            >
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}
              {%- else -%}
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 750px) 46vw, 92vw"
                  alt="{{ media.alt | escape | default: p.title | escape }}"
                  width="1200"
                  height="1200"
                  {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                >
              {%- endif -%}
            </figure>
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
          <span class="iz-gallery__badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}

        {%- if p.media.size > 1 -%}
          <div class="iz-gallery__dots" aria-hidden="true">
            {%- for media in p.media -%}
              <span class="iz-gallery__dot{% if forloop.first %} is-active{% endif %}" data-iz-dot="{{ forloop.index0 }}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if p.media.size > 1 -%}
        <ul class="iz-gallery__thumbs" role="list">
          {%- for media in p.media limit: section.settings.thumb_count -%}
            <li>
              <button
                type="button"
                class="iz-gallery__thumb iz-tap{% if forloop.first %} is-active{% endif %}"
                data-iz-thumb="{{ forloop.index0 }}"
                aria-label="{{ 'Voir le média ' | append: forloop.index }}"
              >
                <img
                  src="{{ media.preview_image | image_url: width: 200 }}"
                  alt=""
                  width="200"
                  height="200"
                  loading="lazy"
                >
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ---------------- Bloc d'achat ---------------- {%- endcomment -%}
    <div class="iz-product__buybox">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'eyebrow' -%}
            {%- assign format = block.settings.texte | default: p.metafields.custom.format -%}
            {%- if format != blank -%}
              <p class="iz-eyebrow" {{ block.shopify_attributes }}>{{ format }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="iz-h1" {{ block.shopify_attributes }}>{{ p.title }}</h1>

          {%- when 'rating' -%}
            {%- assign note = p.metafields.reviews.rating.value -%}
            {%- assign nb = p.metafields.reviews.rating_count | plus: 0 -%}
            {%- if note != blank and nb >= block.settings.minimum -%}
              <a class="iz-rating" href="#{{ block.settings.ancre }}" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7-6.3-3.9-6.3 3.9 1.7-7L2 9.5l7.1-.6z" fill="currentColor"/>
                </svg>
                <strong>{{ note.rating }}</strong>
                <span>· {{ nb }} {{ block.settings.libelle_avis }}</span>
              </a>
            {%- endif -%}

          {%- when 'promise' -%}
            {%- assign promesse = block.settings.texte | default: p.metafields.custom.promesse -%}
            {%- if promesse != blank -%}
              <p class="iz-text iz-product__promise" {{ block.shopify_attributes }}>{{ promesse }}</p>
            {%- endif -%}

          {%- when 'benefits' -%}
            {%- assign benefices = p.metafields.custom.benefices.value -%}
            {%- if benefices != blank and benefices.size > 0 -%}
              <ul class="iz-benefits" role="list" {{ block.shopify_attributes }}>
                {%- for b in benefices -%}
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ b }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'offers' -%}
            {%- comment -%}
              Chaque offre est un produit à part entière : la carte est donc un
              lien vers sa fiche, pas un bouton de variante. La carte du produit
              courant n'est pas un lien et porte l'état sélectionné.
            {%- endcomment -%}
            {%- if offres != blank and offres.size > 0 -%}
              <div class="iz-offers" {{ block.shopify_attributes }}>
                {%- if block.settings.titre != blank -%}
                  <p class="iz-eyebrow">{{ block.settings.titre }}</p>
                {%- endif -%}
                <div class="iz-offers__list">
                  {%- render 'iz-offer-card', offre: p, courant: true -%}
                  {%- for offre in offres -%}
                    {%- unless offre.id == p.id -%}
                      {%- render 'iz-offer-card', offre: offre, courant: false -%}
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'buy' -%}
            <div class="iz-buy" {{ block.shopify_attributes }}>
              <form data-iz-form>
                <input type="hidden" name="id" value="{{ variant.id }}">

                {%- if block.settings.afficher_quantite -%}
                  <div class="iz-qty">
                    <label class="iz-visually-hidden" for="iz-qty-{{ section.id }}">{{ block.settings.libelle_quantite }}</label>
                    <button type="button" class="iz-qty__btn iz-tap" data-iz-qty="-1" aria-label="{{ block.settings.libelle_moins }}">−</button>
                    <input
                      id="iz-qty-{{ section.id }}"
                      class="iz-qty__input"
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      inputmode="numeric"
                    >
                    <button type="button" class="iz-qty__btn iz-tap" data-iz-qty="1" aria-label="{{ block.settings.libelle_plus }}">+</button>
                  </div>
                {%- else -%}
                  <input type="hidden" name="quantity" value="1">
                {%- endif -%}

                <button
                  type="submit"
                  class="iz-btn iz-btn--primary iz-buy__submit"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {%- if variant.available -%}
                    <span data-iz-submit-label>
                      {{ block.settings.libelle_ajout }} — {{ variant.price | money }}
                    </span>
                  {%- else -%}
                    {{ block.settings.libelle_epuise }}
                  {%- endif -%}
                </button>
              </form>
              <p class="iz-buy__feedback" data-iz-feedback role="status" aria-live="polite"></p>
            </div>

          {%- when 'shipping_gauge' -%}
            <div
              class="iz-gauge"
              data-iz-gauge
              data-seuil="{{ block.settings.seuil | times: 100 }}"
              data-texte-restant="{{ block.settings.texte_restant | escape }}"
              data-texte-atteint="{{ block.settings.texte_atteint | escape }}"
              {{ block.shopify_attributes }}
            >
              <p class="iz-gauge__text" data-iz-gauge-text></p>
              <div class="iz-gauge__track"><span class="iz-gauge__fill" data-iz-gauge-fill></span></div>
            </div>

          {%- when 'accordion' -%}
            {%- assign contenu = block.settings.contenu -%}
            {%- if block.settings.source_metafield != blank -%}
              {%- assign contenu = p.metafields.custom[block.settings.source_metafield] -%}
            {%- endif -%}
            {%- if contenu != blank -%}
              <details
                class="iz-accordion"
                {% if block.settings.ouvert %}open{% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="iz-accordion__summary">
                  <span>{{ block.settings.titre }}</span>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                </summary>
                <div class="iz-accordion__body iz-text">{{ contenu }}</div>
              </details>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    /* ---------- Galerie ---------- */
    var slides = root.querySelectorAll('[data-iz-slide]');
    var thumbs = root.querySelectorAll('[data-iz-thumb]');
    var dots = root.querySelectorAll('[data-iz-dot]');

    function montrer(i) {
      slides.forEach(function (s) { s.classList.toggle('is-active', s.dataset.izSlide === String(i)); });
      thumbs.forEach(function (t) { t.classList.toggle('is-active', t.dataset.izThumb === String(i)); });
      dots.forEach(function (d) { d.classList.toggle('is-active', d.dataset.izDot === String(i)); });
    }

    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { montrer(t.dataset.izThumb); });
    });

    /* Balayage horizontal sur mobile. Les gestionnaires sont passifs et
       n'appellent jamais preventDefault : le défilement vertical de la page
       doit continuer de fonctionner par-dessus la galerie. */
    var stage = root.querySelector('[data-iz-stage]');
    if (stage && slides.length > 1) {
      var x0 = 0, y0 = 0, suit = false, courant = 0;
      stage.addEventListener('touchstart', function (e) {
        x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; suit = true;
      }, { passive: true });
      stage.addEventListener('touchend', function (e) {
        if (!suit) return;
        suit = false;
        var dx = e.changedTouches[0].clientX - x0;
        var dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        courant = dx < 0
          ? Math.min(courant + 1, slides.length - 1)
          : Math.max(courant - 1, 0);
        montrer(courant);
      }, { passive: true });
    }

    /* ---------- Quantité ---------- */
    var champQte = root.querySelector('.iz-qty__input');
    root.querySelectorAll('[data-iz-qty]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!champQte) return;
        var v = parseInt(champQte.value, 10) || 1;
        champQte.value = Math.max(1, v + parseInt(b.dataset.izQty, 10));
        champQte.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    /* ---------- Jauge de livraison ----------
       Le calcul porte sur le panier réel, relu après chaque ajout, et non sur
       le prix affiché : c'est le total du panier qui déclenche la franchise. */
    var jauge = root.querySelector('[data-iz-gauge]');

    function majJauge() {
      if (!jauge) return;
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (panier) {
          var seuil = parseInt(jauge.dataset.seuil, 10) || 0;
          var total = panier.total_price || 0;
          var texte = jauge.querySelector('[data-iz-gauge-text]');
          var fill = jauge.querySelector('[data-iz-gauge-fill]');
          if (total >= seuil) {
            texte.textContent = jauge.dataset.texteAtteint;
            fill.style.width = '100%';
          } else {
            var reste = (seuil - total) / 100;
            var formate = reste.toFixed(2).replace('.', ',').replace(/,00$/, '');
            texte.textContent = jauge.dataset.texteRestant.replace('{montant}', formate + ' €');
            fill.style.width = Math.max(2, (total / seuil) * 100) + '%';
          }
        })
        .catch(function () { /* panier injoignable : la jauge reste muette */ });
    }
    majJauge();

    /* ---------- Ajout au panier ---------- */
    var form = root.querySelector('[data-iz-form]');
    var retour = root.querySelector('[data-iz-feedback]');

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var bouton = form.querySelector('[type="submit"]');
        bouton.disabled = true;
        if (retour) retour.textContent = '';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            id: form.querySelector('[name="id"]').value,
            quantity: parseInt(form.querySelector('[name="quantity"]').value, 10) || 1
          })
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            bouton.disabled = false;
            if (!res.ok) {
              if (retour) retour.textContent = res.d.description || form.dataset.erreur || '';
              return;
            }
            if (retour) retour.textContent = {{ section.settings.message_ajout | json }};
            majJauge();
            majCompteur();
          })
          .catch(function () {
            bouton.disabled = false;
            if (retour) retour.textContent = {{ section.settings.message_erreur | json }};
          });
      });
    }

    /* Le thème n'a pas de tiroir panier : on tient au moins le compteur du
       header à jour, sans quoi l'ajout serait invisible. */
    function majCompteur() {
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (panier) {
          document.querySelectorAll('.header__icons sup').forEach(function (el) {
            el.textContent = panier.item_count;
          });
        })
        .catch(function () {});
    }
  })();
</script>

{% stylesheet %}
  .iz-product__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--izp-col-gap, 48px);
  }

  @media (min-width: 750px) {
    .iz-product__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* ---------- Galerie ---------- */
  .iz-gallery__stage {
    position: relative;
    background: var(--iz-surface);
    border-radius: var(--iz-radius);
    overflow: hidden;
    aspect-ratio: var(--izp-gallery-ratio, 1);
  }

  .iz-gallery__slide {
    margin: 0;
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .iz-gallery__slide.is-active {
    opacity: 1;
  }

  .iz-gallery__slide img,
  .iz-gallery__slide video,
  .iz-gallery__slide iframe {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .iz-gallery__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--iz-ink);
    color: var(--iz-bg);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--iz-radius-pill);
  }

  .iz-gallery__dots {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .iz-gallery__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #B5B5B5;
    transition: width 0.2s ease, background-color 0.2s ease;
  }

  .iz-gallery__dot.is-active {
    width: 18px;
    background: var(--iz-ink);
  }

  @media (min-width: 750px) {
    .iz-gallery__dots {
      display: none;
    }
  }

  .iz-gallery__thumbs {
    display: none;
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    gap: 12px;
  }

  @media (min-width: 750px) {
    .iz-gallery__thumbs {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .iz-gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--iz-radius-inner);
    background: var(--iz-surface);
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 1;
  }

  .iz-gallery__thumb.is-active {
    border-color: var(--iz-ink);
  }

  .iz-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ---------- Bloc d'achat ---------- */
  .iz-product__buybox {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .iz-rating {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--iz-ink);
    text-decoration: none;
    align-self: start;
  }

  .iz-rating:hover {
    text-decoration: underline;
  }

  .iz-benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .iz-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.45;
  }

  .iz-benefits svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ---------- Sélecteur d'offre ----------
     Le CSS des cartes vit ici et non dans le snippet : Shopify n'exécute
     les blocs de style que dans les sections, jamais dans les snippets. */
  .iz-offers__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 8px;
    margin-top: 8px;
  }

  .iz-offer {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border: 1px solid var(--iz-line);
    border-radius: var(--iz-radius);
    background: var(--iz-card);
    color: inherit;
    text-decoration: none;
    min-height: 44px;
    transition: border-color 0.2s ease;
  }

  .iz-offer.is-current {
    border-width: 2px;
    border-color: var(--iz-ink);
    padding: 11px 13px;
  }

  @media (hover: hover) {
    a.iz-offer:hover {
      border-color: var(--iz-muted);
    }
  }

  .iz-offer:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .iz-offer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .iz-offer__name {
    font-size: 13px;
    font-weight: 700;
  }

  .iz-offer__badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--iz-radius-pill);
    background: var(--iz-ink);
    color: var(--iz-bg);
  }

  .iz-offer__sub,
  .iz-offer__price {
    font-size: 12px;
    color: var(--iz-muted);
  }

  .iz-offer__price strong {
    color: var(--iz-ink);
  }

  .iz-offer__price s {
    margin-left: 5px;
  }

  /* ---------- Quantité et ajout ---------- */
  .iz-buy form {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  .iz-buy__submit {
    flex: 1;
  }

  .iz-qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--iz-line);
    border-radius: var(--iz-radius-pill);
    overflow: hidden;
  }

  .iz-qty__btn {
    width: 44px;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--iz-ink);
    font-size: 18px;
    cursor: pointer;
  }

  .iz-qty__input {
    width: 40px;
    border: 0;
    background: transparent;
    text-align: center;
    font: inherit;
    color: inherit;
    -moz-appearance: textfield;
  }

  .iz-qty__input::-webkit-outer-spin-button,
  .iz-qty__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .iz-buy__feedback:empty {
    display: none;
  }

  .iz-buy__feedback {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--iz-muted);
  }

  /* ---------- Jauge ---------- */
  .iz-gauge__text {
    margin: 0 0 6px;
    font-size: 13px;
    color: var(--iz-muted);
  }

  .iz-gauge__text:empty {
    display: none;
  }

  .iz-gauge__track {
    height: 4px;
    border-radius: var(--iz-radius-pill);
    background: var(--iz-line);
    overflow: hidden;
  }

  .iz-gauge__fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--iz-ink);
    transition: width 0.4s ease;
  }

  /* ---------- Accordéons ---------- */
  .iz-accordion {
    border-top: 1px solid var(--iz-line);
  }

  .iz-accordion:last-of-type {
    border-bottom: 1px solid var(--iz-line);
  }

  .iz-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 600;
  }

  .iz-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .iz-accordion[open] .iz-accordion__summary svg {
    transform: rotate(180deg);
  }

  .iz-accordion__summary svg {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .iz-accordion__body {
    padding-bottom: 20px;
  }

  .iz-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .iz-gallery__slide,
    .iz-gallery__dot,
    .iz-gauge__fill,
    .iz-accordion__summary svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiche — achat",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Galerie" },
    { "type": "checkbox", "id": "show_badge", "label": "Afficher le badge", "default": true },
