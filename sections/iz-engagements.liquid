{% comment %}
  Fiche produit — bandeau d'engagements.

  Section dédiée aux fiches : la section de réassurance de l'accueil n'est
  pas touchée. Un bloc par engagement, filets en haut et en bas, aligné sur
  la largeur de page.

  Sans aucun bloc, la section ne s'affiche pas.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    --ize-colonnes: {{ section.settings.colonnes }};
    --ize-gap: {{ section.settings.gap }}px;
    --ize-padding: {{ section.settings.padding_vertical }}px;
    --ize-titre: {{ section.settings.taille_titre }}px;
    --ize-texte: {{ section.settings.taille_texte }}px;
    --ize-filet: {{ section.settings.couleur_filet }};
    --ize-texte-couleur: {{ section.settings.couleur_texte }};
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --ize-colonnes: {{ section.settings.colonnes_mobile }};
      --ize-gap: {{ section.settings.gap_mobile }}px;
      --ize-padding: {{ section.settings.padding_vertical_mobile }}px;
      --ize-titre: {{ section.settings.taille_titre_mobile }}px;
      --ize-texte: {{ section.settings.taille_texte_mobile }}px;
    }
  }
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  <section class="iz-eng full-width">
    <div class="iz-eng__grid">
      {%- for block in section.blocks -%}
        <div class="iz-eng__item" {{ block.shopify_attributes }}>
          {%- if block.settings.titre != blank -%}
            <span class="iz-eng__titre">{{ block.settings.titre }}</span>
          {%- endif -%}
          {%- if block.settings.texte != blank -%}
            <span class="iz-eng__texte">{{ block.settings.texte }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .iz-eng {
    border-top: 1px solid var(--ize-filet);
    border-bottom: 1px solid var(--ize-filet);
  }

  /* La grille porte elle-même la largeur de page et les gouttières : le
     texte s'aligne ainsi exactement sur le contenu des sections voisines,
     sans marge intérieure de cellule qui le décalerait vers l'intérieur. */
  .iz-eng__grid {
    max-width: var(--iz-container, 1320px);
    margin-inline: auto;
    padding-inline: var(--iz-gutter, 32px);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(var(--ize-colonnes, 3), minmax(0, 1fr));
    gap: var(--ize-gap, 32px);
  }

  .iz-eng__item {
    padding-block: var(--ize-padding, 28px);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .iz-eng__titre {
    font-weight: 700;
    font-size: var(--ize-titre, 15px);
  }

  .iz-eng__texte {
    font-size: var(--ize-texte, 13px);
    color: var(--ize-texte-couleur, #5C5C5C);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiche — engagements",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "colonnes", "label": "Colonnes — ordinateur", "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "colonnes_mobile", "label": "Colonnes — mobile", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "gap", "label": "Espace entre colonnes — ordinateur", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "gap_mobile", "label": "Espace entre colonnes — mobile", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_vertical", "label": "Hauteur du bandeau — ordinateur", "min": 8, "max": 80, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_vertical_mobile", "label": "Hauteur du bandeau — mobile", "min": 8, "max": 60, "step": 2, "unit": "px", "default": 18 },

    { "type": "header", "content": "Typographie" },
    { "type": "range", "id": "taille_titre", "label": "Titre — ordinateur", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "taille_titre_mobile", "label": "Titre — mobile", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "taille_texte", "label": "Texte — ordinateur", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "taille_texte_mobile", "label": "Texte — mobile", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "couleur_filet", "label": "Filets", "default": "#E2E2DF" },
    { "type": "color", "id": "couleur_texte", "label": "Texte secondaire", "default": "#5C5C5C" }
  ],
  "blocks": [
    {
      "type": "engagement",
      "name": "Engagement",
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre", "default": "Formules naturelles" },
        { "type": "text", "id": "texte", "label": "Texte court", "default": "Des ingrédients choisis, sans compromis." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fiche — engagements",
      "blocks": [{ "type": "engagement" }, { "type": "engagement" }, { "type": "engagement" }]
    }
  ]
}
{% endschema %}
