{% comment %}
  Fiche produit — résultats chiffrés.

  Les chiffres viennent du metafield `resultats` (liste de metaobjets), la
  mention d'étude de `resultats_source`.

  La section ne s'affiche que si les DEUX sont renseignés. Afficher un
  pourcentage sans dire d'où il sort est une allégation non étayée : le
  garde-fou est donc dans le code, pas dans une consigne qu'on oublie.
{% endcomment %}

{%- assign resultats = product.metafields.custom.resultats.value -%}
{%- assign source = product.metafields.custom.resultats_source | default: section.settings.source -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --izr-carte: {{ section.settings.couleur_carte }};
    --izr-marge: {{ section.settings.marge_verticale }}px;
    --izr-min-carte: {{ section.settings.largeur_min_carte }}px;
    --izr-gap: {{ section.settings.gap }}px;
    --izr-carte-padding: {{ section.settings.padding_carte }}px;
    --izr-eyebrow: {{ section.settings.taille_eyebrow }}px;
    --izr-titre: {{ section.settings.taille_titre }}px;
    --izr-chiffre: {{ section.settings.taille_chiffre }}px;
    --izr-libelle: {{ section.settings.taille_libelle }}px;
    --izr-source: {{ section.settings.taille_source }}px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --izr-marge: {{ section.settings.marge_verticale_mobile }}px;
      --izr-carte-padding: {{ section.settings.padding_carte_mobile }}px;
      --izr-eyebrow: {{ section.settings.taille_eyebrow_mobile }}px;
      --izr-titre: {{ section.settings.taille_titre_mobile }}px;
      --izr-chiffre: {{ section.settings.taille_chiffre_mobile }}px;
      --izr-libelle: {{ section.settings.taille_libelle_mobile }}px;
    }
  }

  /* Fond et masquage posés sur le conteneur de la section : uniforme d'une
     section à l'autre, et indépendant de son balisage interne. */
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.couleur_fond }};
  }

  {%- if section.settings.masquer_mobile -%}
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} { display: none; }
    }
  {%- endif -%}
{% endstyle %}

{%- assign a_des_chiffres = false -%}
{%- if resultats != blank and resultats.size > 0 -%}{%- assign a_des_chiffres = true -%}
{%- elsif section.blocks.size > 0 -%}{%- assign a_des_chiffres = true -%}{%- endif -%}

{%- if a_des_chiffres and source != blank -%}
  <section class="iz-res full-width">
    <div class="iz-res__inner">

      {%- if section.settings.eyebrow != blank or section.settings.titre != blank -%}
        <div class="iz-res__entete">
          {%- if section.settings.eyebrow != blank -%}
            <p class="iz-res__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.titre != blank -%}
            <h2 class="iz-res__titre">{{ section.settings.titre }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="iz-res__grille">
        {%- if resultats != blank and resultats.size > 0 -%}
          {%- for r in resultats -%}
            <div class="iz-res__carte">
              <span class="iz-res__chiffre">{{ r.chiffre }}</span>
              <span class="iz-res__libelle">{{ r.libelle }}</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <div class="iz-res__carte" {{ block.shopify_attributes }}>
              <span class="iz-res__chiffre">{{ block.settings.chiffre }}</span>
              <span class="iz-res__libelle">{{ block.settings.libelle }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <p class="iz-res__source">{{ source }}</p>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}

  .iz-res__inner {
    max-width: var(--iz-container, 1320px);
    margin-inline: auto;
    padding-inline: var(--iz-gutter, 32px);
    padding-block: var(--izr-marge, 88px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .iz-res__entete {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .iz-res__eyebrow {
    margin: 0;
    font-size: var(--izr-eyebrow, 12px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .iz-res__titre {
    margin: 0;
    font-size: var(--izr-titre, 40px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* auto-fit plutôt qu'un nombre fixe de colonnes : la grille s'adapte au
     nombre de résultats saisis, qui varie d'un produit à l'autre. */
  .iz-res__grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--izr-min-carte, 240px), 1fr));
    gap: var(--izr-gap, 20px);
  }

  .iz-res__carte {
    background: var(--izr-carte);
    border-radius: var(--iz-radius);
    padding: var(--izr-carte-padding, 32px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .iz-res__chiffre {
    font-size: var(--izr-chiffre, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .iz-res__libelle {
    font-size: var(--izr-libelle, 16px);
  }

  .iz-res__source {
    margin: 0;
    font-size: var(--izr-source, 13px);
    color: var(--iz-text-2);
  }

  @media (max-width: 749px) {
    .iz-res__inner { gap: 28px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiche — résultats",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Fond et affichage"
    },
    {
      "type": "color",
      "id": "couleur_fond",
      "label": "Fond de la section",
      "info": "Alternez deux tons pour séparer les sections.",
      "default": "#FBFAF8"
    },
    {
      "type": "checkbox",
      "id": "masquer_mobile",
      "label": "Masquer sur mobile",
      "default": false
