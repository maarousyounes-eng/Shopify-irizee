      "id": "taille_eyebrow",
      "label": "Sur-titre — ordinateur",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "taille_eyebrow_mobile",
      "label": "Sur-titre — mobile",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
