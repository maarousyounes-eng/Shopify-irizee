{% comment %}
  Fiche produit — mode d'emploi.

  Étapes numérotées depuis le metafield `etapes` (liste de metaobjets
  etape_rituel : titre, description, image). Sans étape, pas de section.

  La numérotation est produite par la boucle et non saisie : elle reste
  juste si une étape est ajoutée, retirée ou déplacée.
{% endcomment %}

{%- assign etapes = product.metafields.custom.etapes.value -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --izl-marge: {{ section.settings.marge_verticale }}px;
    --izl-min: {{ section.settings.largeur_min }}px;
    --izl-gap: {{ section.settings.gap }}px;
    --izl-ratio: {{ section.settings.ratio }};
    --izl-eyebrow: {{ section.settings.taille_eyebrow }}px;
    --izl-titre: {{ section.settings.taille_titre }}px;
    --izl-etape: {{ section.settings.taille_etape }}px;
    --izl-texte: {{ section.settings.taille_texte }}px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --izl-marge: {{ section.settings.marge_verticale_mobile }}px;
      --izl-titre: {{ section.settings.taille_titre_mobile }}px;
      --izl-etape: {{ section.settings.taille_etape_mobile }}px;
    }
  }
{% endstyle %}

{%- if etapes != blank and etapes.size > 0 -%}
  <section class="iz-rituel full-width">
    <div class="iz-rituel__inner">

      <div class="iz-rituel__entete">
        {%- if section.settings.eyebrow != blank -%}
          <p class="iz-rituel__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.titre != blank -%}
          <h2 class="iz-rituel__titre">{{ section.settings.titre }}</h2>
        {%- endif -%}
      </div>

      <ol class="iz-rituel__liste">
        {%- for e in etapes -%}
          <li class="iz-rituel__etape">
            {%- if e.image -%}
              <div class="iz-rituel__media">
                <img
                  src="{{ e.image | image_url: width: 800 }}"
                  srcset="{{ e.image | image_url: width: 400 }} 400w, {{ e.image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 750px) 30vw, 92vw"
                  alt="{{ e.image.alt | escape | default: e.titre | escape }}"
                  width="800" height="600" loading="lazy"
                >
              </div>
            {%- endif -%}
            <div class="iz-rituel__ligne">
              <span class="iz-rituel__numero" aria-hidden="true">{{ forloop.index }}</span>
              <span class="iz-rituel__nom">{{ e.titre }}</span>
            </div>
            {%- if e.description != blank -%}
              <p class="iz-rituel__texte">{{ e.description }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>

    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .iz-rituel {
    border-top: 1px solid var(--iz-line);
  }

  .iz-rituel__inner {
    max-width: var(--iz-container, 1320px);
    margin-inline: auto;
    padding-inline: var(--iz-gutter, 32px);
    padding-block: var(--izl-marge, 88px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .iz-rituel__entete {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .iz-rituel__eyebrow {
    margin: 0;
    font-size: var(--izl-eyebrow, 12px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .iz-rituel__titre {
    margin: 0;
    font-size: var(--izl-titre, 40px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .iz-rituel__liste {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--izl-min, 240px), 1fr));
    gap: var(--izl-gap, 24px);
  }

  .iz-rituel__etape {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .iz-rituel__media {
    aspect-ratio: var(--izl-ratio, 1.333);
    background: var(--iz-surface);
    border-radius: var(--iz-radius);
    overflow: hidden;
  }

  .iz-rituel__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .iz-rituel__ligne {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .iz-rituel__numero {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 16px;
    background: var(--iz-ink);
    color: var(--iz-bg);
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .iz-rituel__nom {
    font-size: var(--izl-etape, 20px);
    font-weight: 700;
  }

  .iz-rituel__texte {
    margin: 0;
    font-size: var(--izl-texte, 15px);
    color: var(--iz-text-2);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiche — rituel",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Alimentée par le metafield etapes. Sans étape, la section ne s'affiche pas. La numérotation est automatique." },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Mode d'emploi" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Le rituel en 3 gestes" },

    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "largeur_min", "label": "Largeur minimale d'une étape", "min": 160, "max": 400, "step": 10, "unit": "px", "default": 240 },
    { "type": "range", "id": "gap", "label": "Espace entre les étapes", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "ratio", "label": "Proportion des images", "info": "1,33 = 4/3.", "min": 0.6, "max": 2, "step": 0.1, "default": 1.3 },
    { "type": "range", "id": "marge_verticale", "label": "Marge verticale — ordinateur", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "marge_verticale_mobile", "label": "Marge verticale — mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },

    { "type": "header", "content": "Typographie" },
    { "type": "range", "id": "taille_eyebrow", "label": "Sur-titre", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "taille_titre", "label": "Titre — ordinateur", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "taille_titre_mobile", "label": "Titre — mobile", "min": 18, "max": 44, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "taille_etape", "label": "Nom d'étape — ordinateur", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "taille_etape_mobile", "label": "Nom d'étape — mobile", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "taille_texte", "label": "Description", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 15 }
  ],
  "presets": [{ "name": "Fiche — rituel" }]
}
{% endschema %}
