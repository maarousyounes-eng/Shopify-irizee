{% comment %}
  Catalogue.

  La grille réutilise `product-card`, la même carte que l'accueil : deux
  catalogues qui ne se ressemblent pas donnent l'impression de deux boutiques.

  Avec trois références, la pagination et les filtres n'ont rien à filtrer :
  ils seraient du bruit. La pagination n'apparaît qu'au-delà de la limite.
{% endcomment %}

{% style %}
  {{ section.settings.police_titre | font_face: font_display: 'swap' }}
  {{ section.settings.police_titre | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {{ section.settings.police_texte | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --izc-marge: {{ section.settings.marge_verticale }}px;
    --izc-gap: {{ section.settings.gap }}px;
    --izc-min: {{ section.settings.largeur_min }}px;

    --izc-titre-famille: {{ section.settings.police_titre.family }}, {{ section.settings.police_titre.fallback_families }};
    --izc-texte-famille: {{ section.settings.police_texte.family }}, {{ section.settings.police_texte.fallback_families }};

    --izc-eyebrow: {{ section.settings.taille_eyebrow }}px;
    --izc-titre: {{ section.settings.taille_titre }}px;
    --izc-texte: {{ section.settings.taille_texte }}px;

    --card-bg: {{ section.settings.couleur_carte }};
    --card-image-inset: {{ section.settings.marge_image }}%;
    --badge-nudge: 0px;

    --fp-category-family: var(--izc-texte-famille);
    --fp-category-size: {{ section.settings.taille_surtitre }}px;
    --fp-category-color: {{ section.settings.couleur_surtitre }};

    --fp-name-family: var(--izc-titre-famille);
    --fp-name-size: {{ section.settings.taille_nom }}px;
    --fp-name-color: {{ section.settings.couleur_nom }};

    --fp-subtitle-family: var(--izc-texte-famille);
    --fp-subtitle-size: {{ section.settings.taille_accroche }}px;

    --fp-badge-family: var(--izc-texte-famille);
    --fp-badge-size: 11px;

    --fp-buy-family: var(--izc-texte-famille);
    --fp-buy-size: 14px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --izc-marge: {{ section.settings.marge_verticale_m }}px;
      --izc-titre: {{ section.settings.taille_titre_m }}px;
      --izc-texte: {{ section.settings.taille_texte_m }}px;
      --fp-category-size: {{ section.settings.taille_surtitre_m }}px;
      --fp-name-size: {{ section.settings.taille_nom_m }}px;
    }
  }
{% endstyle %}

<section class="izc">
  <div class="izc__inner">

    <header class="izc__entete">
      {%- if section.settings.eyebrow != blank -%}
        <p class="izc__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="izc__titre">
        {%- if collection.title != blank -%}{{ collection.title }}{%- else -%}{{ section.settings.titre }}{%- endif -%}
      </h1>

      {%- comment -%}
        Le réglage de la section passe devant la description de la collection.
        L'inverse rendait le texte de ce haut de page impossible à tenir
        depuis le thème : il repartait sur trois lignes à chaque fois.
        La description reste le repli, et continue de servir au référencement.
      {%- endcomment -%}
      {%- if section.settings.intro != blank -%}
        <div class="izc__texte">{{ section.settings.intro }}</div>
      {%- elsif collection.description != blank -%}
        <div class="izc__texte">{{ collection.description }}</div>
      {%- endif -%}

    </header>

    {%- comment -%}
      `paginate` n'accepte qu'une vraie collection, pas un tableau assigné :
      d'où `collection.products` écrit en toutes lettres. Sur une page sans
      collection, la taille est nulle et c'est le texte de repli qui sort.
    {%- endcomment -%}
    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by section.settings.par_page -%}
        <div class="izc__grille">
          {%- for produit in collection.products -%}
            {%- render 'product-card',
              product: produit,
              buy_label: section.settings.libelle_achat,
              cadrage: section.settings.cadrage
            -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="izc__pagination" aria-label="{{ section.settings.libelle_pagination }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="izc__texte">{{ section.settings.texte_vide }}</p>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .izc {
    padding: var(--izc-marge) var(--page-margin);
  }

  .izc__inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
  }

  .izc__entete {
    /* L'intro tenait sur quatre lignes étroites et mangeait le haut de page.
       L'en-tête respire plus large, le texte garde sa longueur de lecture. */
    max-width: 86ch;
    margin-bottom: calc(var(--izc-marge) * 0.5);
  }

  .izc__eyebrow {
    font-family: var(--izc-texte-famille);
    font-size: var(--izc-eyebrow);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    margin-bottom: 1.2rem;
  }

  .izc__titre {
    font-family: var(--izc-titre-famille);
    font-size: var(--izc-titre);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
    margin: 0 0 1.6rem;
  }

  .izc__texte {
    max-width: 62ch;
    font-family: var(--izc-texte-famille);
    font-size: var(--izc-texte);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-foreground) 78%, transparent);
  }

  .izc__texte p { margin: 0 0 1.2rem; }
  .izc__texte p:last-child { margin-bottom: 0; }


  /* La carte vient de product-card : ici on ne fait que la poser en grille.
     Sa largeur est fixée en vw pour le carrousel de l'accueil, on la
     neutralise. */
  .izc__grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--izc-min, 280px), 1fr));
    gap: var(--izc-gap);
  }

  .izc__grille .product-card {
    width: auto;
    max-width: none;
    flex: initial;
  }

  .izc__pagination {
    margin-top: calc(var(--izc-marge) * 0.5);
    font-family: var(--izc-texte-famille);
    font-size: var(--izc-texte);
    display: flex;
    justify-content: center;
    gap: 1.6rem;
  }
{% endstylesheet %}

{%- comment -%}
  Le catalogue ne portait que le balisage d'organisation : rien ne disait aux
  moteurs ce que cette page liste. CollectionPage + ItemList donnent la liste
  et l'ordre des soins, avec leur prix et leur disponibilité.
{%- endcomment -%}
{%- if collection.products.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | default: shop.name | json }},
      "description": {{ collection.description | default: section.settings.intro | strip_html | truncate: 300 | json }},
      "url": {{ canonical_url | json }},
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products.size }},
        "itemListElement": [
          {%- for produit in collection.products -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "item": {
                "@type": "Product",
                "name": {{ produit.title | json }},
                "url": {{ produit.url | prepend: request.origin | json }},
                {%- if produit.featured_image -%}
                  "image": {{ produit.featured_image | image_url: width: 800 | prepend: 'https:' | json }},
                {%- endif -%}
                "offers": {
                  "@type": "Offer",
                  "price": {{ produit.price | divided_by: 100.0 | json }},
                  "priceCurrency": {{ cart.currency.iso_code | json }},
                  "availability": {% if produit.available %}"https://schema.org/PreOrder"{% else %}"https://schema.org/OutOfStock"{% endif %}
                }
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}

