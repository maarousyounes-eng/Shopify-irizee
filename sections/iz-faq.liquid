    {
      "type": "paragraph",
      "content": "Le metafield faq du produit est utilisé en priorité. Sans lui, ce sont les blocs ci-dessous qui s'affichent — pour les questions communes à tous les produits."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "titre_base",
