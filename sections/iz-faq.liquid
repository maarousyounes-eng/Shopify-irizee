      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "reponse",
          "label": "Réponse"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fiche — FAQ"
    },
    {
      "name": "FAQ boutique",
      "settings": {
        "eyebrow": "Questions fréquentes",
        "titre": "Ce qu'on nous demande le plus"
      },
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Quand ma commande sera-t-elle expédiée ?",
            "reponse": "<p>Les soins sont en précommande : la production arrive et les premières expéditions partent à partir de décembre 2026. Vous recevez un email avec le numéro de suivi le jour où votre colis part.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Pourquoi précommander plutôt qu'attendre ?",
            "reponse": "<p>La première série est produite en quantité limitée. Précommander réserve la vôtre et vous place en tête des expéditions, au prix de lancement.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Comment savoir quel soin me convient ?",
            "reponse": "<p>Le diagnostic en ligne pose huit questions sur votre peau et vos habitudes, puis vous dit par où commencer : le masque, le sérum, ou les deux. Il prend moins d'une minute.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Le masque et le sérum s'utilisent-ils ensemble ?",
            "reponse": "<p>Oui, et ils ne se gênent pas : le masque purifie une à deux fois par semaine, le sérum s'applique matin et soir. L'un prépare la peau, l'autre prend le relais au quotidien.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Et si ma peau est sensible ?",
            "reponse": "<p>Les deux formules conviennent à toutes les peaux et sont sans parfum ajouté, avec un pH proche de celui de la peau. Comme pour tout nouveau soin, faites un essai au creux du coude avant la première application.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
