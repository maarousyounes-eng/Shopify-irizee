{% comment %}
  Fiche produit — notre marque.

  Entièrement en réglages de section : le contenu est identique sur toutes
  les fiches, il n'a donc rien à faire dans un metafield produit.

  Sans titre, la section ne s'affiche pas.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    --izm-marge: {{ section.settings.marge_verticale }}px;
    --izm-gap: {{ section.settings.gap }}px;
    --izm-image-base: {{ section.settings.image_base }}px;
    --izm-texte-base: {{ section.settings.texte_base }}px;
    --izm-ratio: {{ section.settings.ratio }};
    --izm-eyebrow: {{ section.settings.taille_eyebrow }}px;
    --izm-titre: {{ section.settings.taille_titre }}px;
    --izm-texte: {{ section.settings.taille_texte }}px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --izm-marge: {{ section.settings.marge_verticale_mobile }}px;
      --izm-gap: {{ section.settings.gap_mobile }}px;
      --izm-titre: {{ section.settings.taille_titre_mobile }}px;
    }
  }

  /* Fond et masquage posés sur le conteneur de la section : uniforme d'une
     section à l'autre, et indépendant de son balisage interne. */
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.couleur_fond }};
  }

  {%- if section.settings.masquer_mobile -%}
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} { display: none; }
    }
  {%- endif -%}
{% endstyle %}

{%- if section.settings.titre != blank -%}
  <section class="iz-marque full-width">
    <div class="iz-marque__inner{% if section.settings.position_image == 'droite' %} iz-marque__inner--inverse{% endif %}">

      <div class="iz-marque__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 46vw, 92vw"
            alt="{{ section.settings.image.alt | escape | default: section.settings.titre | escape }}"
            width="1200" height="900" loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="iz-marque__texte">
        {%- if section.settings.eyebrow != blank -%}
          <p class="iz-marque__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="iz-marque__titre">{{ section.settings.titre }}</h2>
        {%- if section.settings.texte != blank -%}
          <div class="iz-marque__corps">{{ section.settings.texte }}</div>
        {%- endif -%}
        {%- if section.settings.bouton_label != blank and section.settings.bouton_lien != blank -%}
          <a class="iz-btn iz-btn--secondary iz-marque__bouton" href="{{ section.settings.bouton_lien }}">
            {{ section.settings.bouton_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </section>
{%- endif -%}

{% stylesheet %}

  .iz-marque__inner {
    max-width: var(--iz-container, 1320px);
    margin-inline: auto;
    padding-inline: var(--iz-gutter, 32px);
    padding-block: var(--izm-marge, 88px);
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    gap: var(--izm-gap, 56px);
    align-items: center;
  }

  /* Comme pour la texture : l'inversion ne touche que l'ordre visuel, le
     texte reste lu en premier. */
  .iz-marque__inner--inverse .iz-marque__media {
    order: 2;
  }

  .iz-marque__media {
    flex: 1 1 var(--izm-image-base, 420px);
    min-width: 0;
    aspect-ratio: var(--izm-ratio, 1.333);
    background: var(--iz-line);
    border-radius: var(--iz-radius);
    overflow: hidden;
  }

  .iz-marque__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .iz-marque__texte {
    flex: 1 1 var(--izm-texte-base, 420px);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .iz-marque__eyebrow {
    margin: 0;
    font-size: var(--izm-eyebrow, 12px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .iz-marque__titre {
    margin: 0;
    font-size: var(--izm-titre, 40px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .iz-marque__corps {
    font-size: var(--izm-texte, 16px);
    color: var(--iz-text-2);
  }

  /* Le thème remet les marges des paragraphes à zéro : sans cette règle,
     deux paragraphes d'un texte enrichi se touchent. Constaté sur la
     section texture du Masque. */
  .iz-marque__corps p + p { margin-top: 1em; }

  .iz-marque__corps > :first-child { margin-top: 0; }
  .iz-marque__corps > :last-child { margin-bottom: 0; }

  .iz-marque__bouton {
    align-self: flex-start;
  }

  @media (max-width: 749px) {
    .iz-marque__inner--inverse .iz-marque__media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiche — marque",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Fond et affichage"
    },
    {
      "type": "color",
      "id": "couleur_fond",
      "label": "Fond de la section",
      "info": "Alternez deux tons pour séparer les sections.",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "masquer_mobile",
      "label": "Masquer sur mobile",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Contenu identique sur toutes les fiches. Sans titre, la section ne s'affiche pas."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Notre marque"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Nous avons commencé par retirer, pas par ajouter"
    },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "bouton_label",
      "label": "Libellé du bouton",
      "default": "Découvrir"
    },
    {
      "type": "url",
      "id": "bouton_lien",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "position_image",
      "label": "Position de l'image",
      "options": [
        {
          "value": "gauche",
          "label": "À gauche"
        },
        {
          "value": "droite",
          "label": "À droite"
        }
      ],
      "default": "gauche"
    },
    {
      "type": "range",
      "id": "ratio",
      "label": "Proportion de l'image",
      "min": 0.6,
      "max": 2,
      "step": 0.1,
      "default": 1.3
    },
    {
      "type": "range",
      "id": "image_base",
      "label": "Largeur de référence — image",
      "min": 280,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "texte_base",
      "label": "Largeur de référence — texte",
      "min": 280,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espace entre les colonnes — ordinateur",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Espace entre les colonnes — mobile",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "marge_verticale",
      "label": "Marge verticale — ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "marge_verticale_mobile",
      "label": "Marge verticale — mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "range",
      "id": "taille_eyebrow",
      "label": "Sur-titre",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "taille_titre",
      "label": "Titre — ordinateur",
      "min": 20,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "taille_titre_mobile",
      "label": "Titre — mobile",
      "min": 18,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "taille_texte",
      "label": "Texte",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Fiche — marque"
    }
  ]
}
{% endschema %}
