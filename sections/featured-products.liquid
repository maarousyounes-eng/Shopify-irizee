{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {{ section.settings.category_font | font_face: font_display: 'swap' }}
  {{ section.settings.category_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {{ section.settings.name_font | font_face: font_display: 'swap' }}
  {{ section.settings.name_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {{ section.settings.subtitle_font | font_face: font_display: 'swap' }}
  {{ section.settings.badge_font | font_face: font_display: 'swap' }}
  {{ section.settings.buy_font | font_face: font_display: 'swap' }}
  {{ section.settings.cta_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --card-bg: {{ section.settings.card_background | default: '#E8E6E5' }};
    --card-image-inset: {{ section.settings.image_inset }}%;
    --badge-nudge: {{ section.settings.badge_nudge }}px;

    --fp-heading-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --fp-heading-size: {{ section.settings.heading_size }}px;

    --fp-category-family: {{ section.settings.category_font.family }}, {{ section.settings.category_font.fallback_families }};
    --fp-category-size: {{ section.settings.category_size }}px;
    --fp-category-color: {{ section.settings.category_color }};

    --fp-name-family: {{ section.settings.name_font.family }}, {{ section.settings.name_font.fallback_families }};
    --fp-name-size: {{ section.settings.name_size }}px;
    --fp-name-color: {{ section.settings.name_color }};

    --fp-subtitle-family: {{ section.settings.subtitle_font.family }}, {{ section.settings.subtitle_font.fallback_families }};
    --fp-subtitle-size: {{ section.settings.subtitle_size }}px;

    --fp-badge-family: {{ section.settings.badge_font.family }}, {{ section.settings.badge_font.fallback_families }};
    --fp-badge-size: {{ section.settings.badge_size }}px;

    --fp-buy-family: {{ section.settings.buy_font.family }}, {{ section.settings.buy_font.fallback_families }};
    --fp-buy-size: {{ section.settings.buy_size }}px;

    --fp-cta-family: {{ section.settings.cta_font.family }}, {{ section.settings.cta_font.fallback_families }};
    --fp-cta-size: {{ section.settings.cta_size }}px;
  }

  /* Tailles mobiles : totalement indépendantes des tailles desktop ci-dessus */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --fp-heading-size: {{ section.settings.heading_size_mobile }}px;
      --fp-category-size: {{ section.settings.category_size_mobile }}px;
      --fp-name-size: {{ section.settings.name_size_mobile }}px;
      --fp-subtitle-size: {{ section.settings.subtitle_size_mobile }}px;
      --fp-badge-size: {{ section.settings.badge_size_mobile }}px;
      --fp-buy-size: {{ section.settings.buy_size_mobile }}px;
      --fp-cta-size: {{ section.settings.cta_size_mobile }}px;
    }
  }

  {% if section.settings.blend_white_bg %}
    #shopify-section-{{ section.id }} .product-card__image--primary {
      mix-blend-mode: multiply;
    }
  {% endif %}

  {%- if section.settings.button_custom -%}
    {%- comment -%} Ce bouton s'écarte du style commun : on redéfinit les
      variables au niveau de la section, ce qui l'emporte sur :root. {%- endcomment -%}
    #shopify-section-{{ section.id }} {
      --button-radius: {{ section.settings.button_radius }}px;
      --button-padding-y: {{ section.settings.button_padding_y }}px;
      --button-padding-x: {{ section.settings.button_padding_x }}px;
      --button-font-weight: {{ section.settings.button_font_weight }};
      --button-letter-spacing: {{ section.settings.button_letter_spacing }}px;
      --button-text-transform: {{ section.settings.button_text_transform }};
    }
  {%- endif -%}
{% endstyle %}

<div class="featured-products full-width">
  <div class="featured-products__inner">
    {% if section.settings.heading != blank %}
      <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="featured-products__carousel">
      <div class="featured-products__grid" data-products-row>
      {% if section.settings.source == 'collection' %}
        {% assign products = section.settings.collection.products | default: empty %}
        {% for product in products limit: section.settings.products_count %}
          {% assign badge_text = '' %}
          {% if product.tags contains 'bestseller' %}
            {% assign badge_text = 'Best-seller' %}
          {% elsif product.tags contains 'limited' %}
            {% assign badge_text = 'Édition limitée' %}
          {% elsif product.tags contains 'new' %}
            {% assign badge_text = 'Nouveau' %}
          {% endif %}
          {% render 'product-card', product: product, badge_text: badge_text, buy_label: section.settings.buy_label, cadrage: section.settings.primary_fit %}
        {% else %}
          <p class="featured-products__empty">Choisis une collection dans les réglages de cette section.</p>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.settings.product != blank %}
            {% render 'product-card', product: block.settings.product, badge_text: block.settings.badge_text, category_label: block.settings.category_label, buy_label: section.settings.buy_label, cadrage: section.settings.primary_fit %}
          {% endif %}
        {% endfor %}
      {% endif %}
      </div>

      <button class="featured-products__arrow featured-products__arrow--prev" type="button" data-products-prev aria-label="Voir les produits précédents" hidden>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <button class="featured-products__arrow featured-products__arrow--next" type="button" data-products-next aria-label="Voir les produits suivants" hidden>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    {% if section.settings.button_label != blank %}
      <div class="featured-products__cta">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="featured-products__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    // Flèches de défilement : chacune n'apparaît que s'il reste des produits
    // à voir de son côté, et seulement si la rangée déborde.
    var row = root.querySelector('[data-products-row]');
    var next = root.querySelector('[data-products-next]');
    var prev = root.querySelector('[data-products-prev]');

    if (row && next && prev) {
      var updateArrows = function () {
        var overflows = row.scrollWidth - row.clientWidth > 8;
        var atEnd = row.scrollLeft + row.clientWidth >= row.scrollWidth - 8;
        var atStart = row.scrollLeft <= 8;
        next.hidden = !overflows || atEnd;
        prev.hidden = !overflows || atStart;
      };

      var step = function () {
        var card = row.querySelector('.product-card');
        return card ? card.getBoundingClientRect().width + 32 : row.clientWidth * 0.8;
      };

      next.addEventListener('click', function () {
        row.scrollBy({ left: step(), behavior: 'smooth' });
      });

      prev.addEventListener('click', function () {
        row.scrollBy({ left: -step(), behavior: 'smooth' });
      });

      row.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    }

    root.querySelectorAll('[data-swipe-media]').forEach(function (media) {
      var startX = 0;
      var startY = 0;
      var tracking = false;

      media.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        tracking = true;
      }, { passive: true });

      media.addEventListener('touchend', function (e) {
        if (!tracking) return;
        tracking = false;

        var dx = e.changedTouches[0].clientX - startX;
        var dy = e.changedTouches[0].clientY - startY;

        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          media.closest('.product-card').classList.toggle('product-card--swiped');
        }
      }, { passive: true });
    });
  })();
</script>

{% stylesheet %}
  .featured-products {
    padding: 5rem var(--page-margin);
  }

  .featured-products__heading {
    font-family: var(--fp-heading-family);
    font-size: var(--fp-heading-size);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-bottom: 3.2rem;
  }

  .featured-products__carousel {
    position: relative;
  }

  .featured-products__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 4.4rem;
    height: 4.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .featured-products__arrow--next {
    right: -1.6rem;
  }

  .featured-products__arrow--prev {
    left: -1.6rem;
  }

  .featured-products__arrow:hover {
    transform: translateY(-50%) scale(1.06);
  }

  .featured-products__arrow svg {
    width: 2rem;
    height: 2rem;
  }

  .featured-products__grid {
    display: flex;
    gap: 3.2rem;
    overflow-x: auto;
    /* Déclarer overflow-x seul fait calculer overflow-y: auto par le CSS :
       la rangée devenait un conteneur de défilement sur les deux axes et
       avalait le scroll vertical de la page. */
    overflow-y: hidden;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    justify-content: safe center;
    padding-bottom: 0.4rem;
    scrollbar-width: none;
  }

  .featured-products__grid::-webkit-scrollbar {
    display: none;
  }

  .featured-products__empty {
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    font-size: 1.4rem;
  }

  /* ---------- Carte produit ---------- */

  .product-card {
    position: relative;
    display: block;
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: 78vw;
    max-width: 34rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg, var(--color-background));
    /* Confine la fusion des photos au fond de la carte (et pas à la page) */
    isolation: isolate;
    border-radius: 1.2rem;
    aspect-ratio: 449 / 575;
    transition: transform 0.25s ease;
  }

  @media (min-width: 750px) {
    .product-card {
      width: 40vw;
      max-width: 45rem;
    }
  }

  @media (min-width: 1200px) {
    .product-card {
      width: 30vw;
      max-width: 45rem;
    }
  }

  /* Pas de z-index ici : un contexte d'empilement empêcherait la fusion du fond blanc */
  .product-card__media {
    position: absolute;
    inset: 0;
  }

  .product-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Photo packshot : produit entier visible, avec de la marge autour (jamais recadré) */
  .product-card__image--primary {
    object-fit: contain;
    padding: var(--card-image-inset, 14%) var(--card-image-inset, 14%) calc(var(--card-image-inset, 14%) + 4%);
  }

  /* Première photo en situation plutôt qu'en packshot : elle doit remplir la
     carte bord à bord, la marge du packshot n'aurait aucun sens. */
  .product-card--plein .product-card__image--primary {
    object-fit: cover;
    padding: 0;
  }

  /* Photo lifestyle au survol : plein cadre, bord à bord */
  .product-card__image--secondary {
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .product-card__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.6rem 1.2rem;
  }

  .product-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .product-card__type {
    font-family: var(--fp-category-family);
    font-size: var(--fp-category-size);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fp-category-color);
  }

  .product-card__badge {
    flex-shrink: 0;
    background: color-mix(in srgb, var(--color-foreground) 85%, transparent);
    color: var(--color-background);
    font-family: var(--fp-badge-family);
    font-size: var(--fp-badge-size);
    font-weight: 600;
    transform: translateY(var(--badge-nudge, 0px));
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    line-height: 1.4;
  }

  .product-card__bottom {
    position: relative;
  }

  .product-card__info {
    transition: opacity 0.25s ease;
  }

  .product-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .product-card__title {
    font-family: var(--fp-name-family);
    font-size: var(--fp-name-size);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--fp-name-color);
  }

  .product-card__price {
    font-family: var(--fp-name-family);
    font-size: var(--fp-name-size);
    font-weight: 700;
    white-space: nowrap;
  }

  .product-card__subtitle {
    font-family: var(--fp-subtitle-family);
    font-size: var(--fp-subtitle-size);
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    margin-top: 0.4rem;
  }

  /* Bouton d'achat : caché par défaut, apparaît au survol par-dessus les infos */
  .product-card__buy {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: var(--color-background);
    color: var(--color-foreground);
    border-radius: 999px;
    padding: 1.4rem 2rem;
    font-family: var(--fp-buy-family);
    font-size: var(--fp-buy-size);
    text-align: center;
    opacity: 0;
    transform: translateY(0.6rem);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  /* ---------- États : survol (souris) et swipe (tactile) ---------- */

  .product-card--swiped .product-card__image--secondary {
    opacity: 1;
  }

  .product-card--swiped .product-card__info {
    opacity: 0;
  }

  .product-card--swiped .product-card__buy {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) {
    .product-card--has-secondary:hover {
      transform: scale(1.02);
    }

    .product-card--has-secondary:hover .product-card__image--secondary {
      opacity: 1;
    }

    .product-card--has-secondary:hover .product-card__info {
      opacity: 0;
    }

    .product-card--has-secondary:hover .product-card__buy {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- Bouton "Tout voir" ---------- */

  .featured-products__cta {
    display: flex;
    justify-content: center;
    margin-top: 3.2rem;
  }

  .featured-products__button {
    display: inline-block;
    padding: var(--button-padding-y) var(--button-padding-x);
    border: 1px solid var(--color-foreground);
    border-radius: var(--button-radius);
    color: var(--color-foreground);
    text-decoration: none;
    font-family: var(--fp-cta-family);
    font-size: var(--fp-cta-size);
    text-transform: var(--button-text-transform);
    letter-spacing: var(--button-letter-spacing);
    font-weight: var(--button-font-weight);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .featured-products__button:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produits phares",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Sélection de rentrée"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source des produits",
      "options": [
        {
          "value": "manual",
          "label": "Sélection manuelle (blocs produit)"
        },
        {
          "value": "collection",
          "label": "Automatique (depuis une collection)"
        }
      ],
      "default": "manual"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (mode automatique)"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Nombre de produits (mode automatique)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
