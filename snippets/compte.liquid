{% comment %}
  Les styles des pages de compte, rendus une seule fois par page.

  Ils vivent dans un snippet et non dans une section : les pages de compte
  sont des gabarits Liquid, et `{% stylesheet %}` n'existe que dans une
  section. Un seul fichier à tenir, chargé seulement là où il sert.

  La tenue reprend celle du reste du site : une colonne de lecture, des
  filets plutôt que des encadrés, et les boutons du thème.
{% endcomment %}

<style>
  .compte {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4rem, 7vw, 8rem) var(--page-margin);
  }

  .compte--large { max-width: var(--page-width, 140rem); }

  .compte__sur {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 55%, transparent);
    margin: 0 0 1.2rem;
  }

  .compte__titre {
    font-size: clamp(2.8rem, 4vw, 4.4rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: 0 0 1.6rem;
  }

  .compte__texte {
    font-size: 1.6rem;
    line-height: 1.6;
    max-width: 58ch;
    margin: 0 0 3.2rem;
  }

  .compte__bloc {
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    padding-top: 2.4rem;
    margin-top: 3.2rem;
  }

  .compte__bloc-titre {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 55%, transparent);
    margin: 0 0 1.6rem;
  }

  .compte__form { display: grid; gap: 1.6rem; max-width: 44rem; }
  .compte__form--large { max-width: 72rem; }

  .compte__duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.6rem;
  }

  .compte__champ { display: grid; gap: 0.6rem; min-width: 0; }

  .compte__label {
    font-size: 1.3rem;
    font-weight: 600;
  }

  .compte__champ input,
  .compte__champ select {
    width: 100%;
    padding: 1.3rem 1.6rem;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 999px;
    background: var(--color-background, #fff);
    color: inherit;
    font: inherit;
    font-size: 1.5rem;
  }

  .compte__champ select { border-radius: 1.2rem; }

  .compte__champ input:focus-visible,
  .compte__champ select:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .compte__case {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
  }

  .compte__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 2rem;
    margin-top: 0.8rem;
  }

  .compte__lien {
    font-size: 1.4rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Une erreur de connexion doit se voir avant le formulaire, pas après. */
  .compte__erreurs {
    border-left: 2px solid #b3261e;
    padding: 0.4rem 0 0.4rem 1.4rem;
    margin: 0 0 2.4rem;
    font-size: 1.4rem;
    line-height: 1.5;
  }

  .compte__erreurs ul { margin: 0; padding-left: 1.6rem; }

  .compte__succes {
    border-left: 2px solid currentColor;
    padding: 0.4rem 0 0.4rem 1.4rem;
    margin: 0 0 2.4rem;
    font-size: 1.4rem;
  }

  /* Les commandes : un tableau sur grand écran, des fiches sur téléphone.
     Les en-têtes restent lus par les lecteurs d'écran dans les deux cas. */
  .compte__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.5rem;
  }

  .compte__table th,
  .compte__table td {
    text-align: left;
    padding: 1.4rem 1.6rem 1.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    vertical-align: top;
  }

  .compte__table th {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 55%, transparent);
  }

  .compte__total td { font-weight: 700; border-bottom: 0; }

  .compte__vide {
    font-size: 1.6rem;
    line-height: 1.6;
    max-width: 52ch;
  }

  .compte__adresses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(26rem, 1fr));
    gap: 2.4rem 3.2rem;
  }

  .compte__adresse {
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    padding-top: 1.8rem;
    font-size: 1.5rem;
    line-height: 1.6;
  }

  .compte__defaut {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 55%, transparent);
    margin-bottom: 0.8rem;
  }

  .compte__pagination {
    display: flex;
    gap: 1.6rem;
    margin-top: 2.4rem;
    font-size: 1.4rem;
  }

  @media (max-width: 749px) {
    .compte__table,
    .compte__table tbody,
    .compte__table tr,
    .compte__table td { display: block; width: 100%; }

    .compte__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

    .compte__table tr {
      border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
      padding: 1.6rem 0;
    }

    .compte__table td {
      border: 0;
      padding: 0.3rem 0;
    }

    .compte__table td::before {
      content: attr(data-libelle) " : ";
      font-weight: 700;
    }
  }
</style>
