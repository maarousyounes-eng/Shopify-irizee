[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "144rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "176rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "144rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#214975",
        "label": "Couleur d'accent (bleu nila)"
      },
      {
        "type": "color",
        "id": "accent_color_soft",
        "default": "#EAF0F5",
        "label": "Couleur d'accent — version douce"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Boutons",
    "settings": [
      {
        "type": "paragraph",
        "content": "Forme commune à tous les boutons du site. Les couleurs restent réglables section par section."
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Arrondi",
        "min": 0,
        "max": 999,
        "step": 1,
        "unit": "px",
        "default": 999
      },
      {
        "type": "range",
        "id": "button_padding_y",
        "label": "Hauteur (marge verticale)",
        "min": 6,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "range",
        "id": "button_padding_x",
        "label": "Largeur (marge horizontale)",
        "min": 10,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 26
      },
      {
        "type": "range",
        "id": "button_font_weight",
        "label": "Graisse du texte",
        "min": 400,
        "max": 900,
        "step": 100,
        "default": 700
      },
      {
        "type": "range",
        "id": "button_letter_spacing",
        "label": "Espacement des lettres",
        "min": -1,
        "max": 4,
        "step": 0.5,
        "unit": "px",
        "default": 1
      },
      {
        "type": "select",
        "id": "button_text_transform",
        "label": "Casse du texte",
        "options": [
          {
            "value": "none",
            "label": "Normale"
          },
          {
            "value": "uppercase",
            "label": "Majuscules"
          }
        ],
        "default": "uppercase"
      }
    ]
  }
]
