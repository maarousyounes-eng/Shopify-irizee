[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Carrée, 512 px minimum. Laisser vide pour utiliser l'icône dessinée dans le thème."
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "144rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "176rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "144rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#214975",
        "label": "Couleur d'accent (bleu nila)"
      },
      {
        "type": "color",
        "id": "accent_color_soft",
        "default": "#EAF0F5",
        "label": "Couleur d'accent — version douce"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Boutons",
    "settings": [
      {
        "type": "paragraph",
        "content": "Forme commune à tous les boutons du site. Les couleurs restent réglables section par section."
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Arrondi",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 100
      },
      {
        "type": "range",
        "id": "button_padding_y",
        "label": "Hauteur (marge verticale)",
        "min": 6,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "range",
        "id": "button_padding_x",
        "label": "Largeur (marge horizontale)",
        "min": 10,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 26
      },
      {
        "type": "range",
        "id": "button_font_weight",
        "label": "Graisse du texte",
        "min": 400,
        "max": 900,
        "step": 100,
        "default": 700
      },
      {
        "type": "range",
        "id": "button_letter_spacing",
        "label": "Espacement des lettres",
        "min": -1,
        "max": 4,
        "step": 0.5,
        "unit": "px",
        "default": 1
      },
      {
        "type": "select",
        "id": "button_text_transform",
        "label": "Casse du texte",
        "options": [
          {
            "value": "none",
            "label": "Normale"
          },
          {
            "value": "uppercase",
            "label": "Majuscules"
          }
        ],
        "default": "uppercase"
      }
    ]
  },
  {
    "name": "Précommande",
    "settings": [
      {
        "type": "paragraph",
        "content": "Un produit passe en précommande tout seul dès que son stock suivi tombe à zéro et que la vente reste autorisée. Rien à cocher produit par produit."
      },
      {
        "type": "checkbox",
        "id": "precommande_active",
        "label": "Activer la précommande",
        "info": "Décochez le jour où le stock arrive : les boutons et les mentions redeviennent normaux partout.",
        "default": true
      },
      {
        "type": "text",
        "id": "precommande_libelle",
        "label": "Bouton",
        "default": "Précommander"
      },
      {
        "type": "text",
        "id": "precommande_badge",
        "label": "Pastille",
        "default": "Précommande"
      },
      {
        "type": "text",
        "id": "precommande_mention",
        "label": "Date d'expédition",
        "info": "Mention obligatoire. Elle s'affiche sous le bouton d'achat et dans le panier.",
        "default": "Expédition à partir de décembre 2026"
      },
      {
        "type": "text",
        "id": "precommande_rassurance",
        "label": "Réassurance",
        "default": "Le paiement est encaissé à la commande. Vous êtes prévenu par email dès l'expédition."
      }
    ]
  },
  {
    "name": "Partage et SEO",
    "settings": [
      {
        "type": "paragraph",
        "content": "L'image ci-dessous s'affiche quand un lien du site est partagé sur WhatsApp, Instagram, Facebook ou envoyé par message. Sans elle, le lien sort gris et sans visuel. Format conseillé : 1200 x 630 px."
      },
      {
        "type": "image_picker",
        "id": "image_partage",
        "label": "Image de partage par défaut"
      }
    ]
  }
]
